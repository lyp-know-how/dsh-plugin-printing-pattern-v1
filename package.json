{
  "name": "@local/yinran-pattern-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "印染花型防坑助手：按客户需求与面料生成 Prompt、版权提示、工艺排雷和交付话术。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
